@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-container glass-card">
    <h2>Login</h2>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn-primary">Login</button>

        <div class="social-login" style="margin-top:1.5rem;">
    <p style="text-align:center; color:#b0a0c8;">Or login with</p>
    <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
        <a asp-action="ExternalLogin" asp-route-provider="Google" class="btn-social" style="background:#db4437; color:#fff; padding:0.5rem 1.2rem; border-radius:0.5rem; text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;">
            <i class="fab fa-google"></i> Google
        </a>
        <a asp-action="ExternalLogin" asp-route-provider="GitHub" class="btn-social" style="background:#333; color:#fff; padding:0.5rem 1.2rem; border-radius:0.5rem; text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;">
            <i class="fab fa-github"></i> GitHub
        </a>
        <a asp-action="TelegramLogin" class="btn-social" style="background:#0088cc; color:#fff; padding:0.5rem 1.2rem; border-radius:0.5rem; text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem;">
            <i class="fab fa-telegram"></i> Telegram
        </a>
    </div>
</div>
    </form>
    <p>Don't have an account? <a href="/User/SignUp">Sign up</a></p>
</div>
