@{
    ViewData["Title"] = "AI Chat Assistant";
    var history = ViewBag.History as List<ChatMessage> ?? new List<ChatMessage>();
}
<div class="chat-container glass-card" style="max-width:800px; margin:2rem auto; padding:0; overflow:hidden; display:flex; flex-direction:column; height:70vh;">
    <div class="chat-header" style="background:rgba(24,15,41,0.7); padding:1rem 1.5rem; border-bottom:1px solid rgba(168,85,247,0.2);">
        <h2 style="margin:0; display:flex; align-items:center; gap:0.5rem;">
            <span>🤖</span> AI Chat Assistant
        </h2>
        <small style="color:#b0a0c8;">Ask me anything about E‑Commerce Rex services.</small>
    </div>
    <div id="chat-messages" style="flex:1; overflow-y:auto; padding:1rem 1.5rem; display:flex; flex-direction:column; gap:0.8rem;">
        @if (!history.Any())
        {
            <div class="message assistant" style="align-self:flex-start; background:rgba(124,58,237,0.2); padding:0.8rem 1.2rem; border-radius:1rem; max-width:80%; border:1px solid rgba(168,85,247,0.2);">
                Hello! I'm your AI assistant. Ask me about products, banking, attendance, or anything else about our platform.
            </div>
        }
        else
        {
            @foreach (var msg in history)
            {
                <div class="message @msg.Role" style="align-self:@(msg.Role == "user" ? "flex-end" : "flex-start"); background:@(msg.Role == "user" ? "rgba(168,85,247,0.4)" : "rgba(24,15,41,0.6)"); padding:0.8rem 1.2rem; border-radius:1rem; max-width:80%; border:1px solid @(msg.Role == "user" ? "rgba(168,85,247,0.4)" : "rgba(168,85,247,0.15)");">
                    @msg.Content
                </div>
            }
        }
    </div>
    <div class="chat-input" style="padding:0.8rem 1.5rem; background:rgba(24,15,41,0.4); border-top:1px solid rgba(168,85,247,0.15); display:flex; gap:0.8rem;">
        <input type="text" id="userInput" placeholder="Type your message..." class="form-control" style="flex:1; padding:0.6rem 1rem; border-radius:2rem; border:1px solid rgba(168,85,247,0.3); background:rgba(24,15,41,0.3); color:#e0d7f0;" />
        <button id="sendBtn" class="btn-primary" style="border-radius:2rem; padding:0.6rem 1.5rem; width:auto;">Send</button>
        <a href="/AIChat/ClearHistory" class="btn-secondary" style="border-radius:2rem; padding:0.6rem 1.2rem; background:transparent; border:1px solid rgba(168,85,247,0.3); color:#c084fc; text-decoration:none;">Clear</a>
    </div>
</div>

<script>
    const messagesDiv = document.getElementById('chat-messages');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');

    function appendMessage(role, content) {
        const div = document.createElement('div');
        div.className = `message ${role}`;
        div.style.alignSelf = role === 'user' ? 'flex-end' : 'flex-start';
        div.style.background = role === 'user' ? 'rgba(168,85,247,0.4)' : 'rgba(24,15,41,0.6)';
        div.style.padding = '0.8rem 1.2rem';
        div.style.borderRadius = '1rem';
        div.style.maxWidth = '80%';
        div.style.border = `1px solid ${role === 'user' ? 'rgba(168,85,247,0.4)' : 'rgba(168,85,247,0.15)'}`;
        div.textContent = content;
        messagesDiv.appendChild(div);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    async function sendMessage() {
        const message = userInput.value.trim();
        if (!message) return;

        // Disable input temporarily
        userInput.disabled = true;
        sendBtn.disabled = true;
        sendBtn.textContent = '...';

        // Append user message immediately
        appendMessage('user', message);
        userInput.value = '';

        try {
            const response = await fetch('/AIChat/Send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `message=${encodeURIComponent(message)}`
            });
            const data = await response.json();
            if (data.reply) {
                appendMessage('assistant', data.reply);
            } else {
                appendMessage('assistant', 'Sorry, I encountered an error.');
            }
        } catch (e) {
            appendMessage('assistant', 'Network error. Please try again.');
        } finally {
            userInput.disabled = false;
            sendBtn.disabled = false;
            sendBtn.textContent = 'Send';
        }
    }

    sendBtn.addEventListener('click', sendMessage);
    userInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') sendMessage();
    });
</script>
