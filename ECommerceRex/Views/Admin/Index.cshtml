@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="glass-card">
    <h2>Admin Panel</h2>
    <p>Welcome, @User.Identity?.Name</p>
    <div class="admin-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap:1rem;">
        <a href="/Admin/UserList" class="btn-primary" style="text-align:center;">User List</a>
        <a href="/Admin/ProdList" class="btn-primary" style="text-align:center;">Products</a>
        <a href="/Admin/CRM" class="btn-primary" style="text-align:center;">CRM</a>
    </div>
    @if (ViewBag.TamperAlert == true)
    {
        <div class="alert alert-danger">⚠️ Tampered records detected!</div>
    }
</div>
