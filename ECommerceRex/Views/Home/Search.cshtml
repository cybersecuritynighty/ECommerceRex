@model IEnumerable<ECommerceRex.Models.Product>
@{
    ViewData["Title"] = "Search Products";
    var query = ViewBag.Query as string;
}

<style>
    .search-container {
        max-width: 800px;
        margin: 0 auto;
    }
    .search-box {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }
    .search-box input {
        flex: 1;
        padding: 0.7rem 1rem;
        border-radius: 2rem;
        border: 1px solid rgba(168,85,247,0.3);
        background: rgba(24,15,41,0.3);
        color: #e0d7f0;
        font-size: 1rem;
    }
    .search-box input:focus {
        outline: none;
        border-color: #c084fc;
        box-shadow: 0 0 0 3px rgba(124,58,237,0.2);
    }
    .search-box button {
        padding: 0.7rem 1.5rem;
        border-radius: 2rem;
        border: none;
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }
    .search-box button:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 16px rgba(124,58,237,0.4);
    }
    .results-count {
        color: #b0a0c8;
        margin-bottom: 1rem;
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }
    .product-card {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s;
    }
    .product-card:hover {
        transform: translateY(-4px);
        border-color: rgba(168,85,247,0.4);
    }
    .product-card .product-image {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }
    .product-card h3 {
        margin: 0.2rem 0;
        color: #e0d7f0;
        font-size: 1.1rem;
    }
    .product-card .price {
        font-size: 1.2rem;
        font-weight: 700;
        color: #c084fc;
        margin: 0.2rem 0;
    }
    .product-card .stock {
        font-size: 0.8rem;
        color: #b0a0c8;
        margin-bottom: 0.5rem;
    }
    .product-card .btn-details {
        background: rgba(124,58,237,0.2);
        border: 1px solid rgba(168,85,247,0.3);
        color: #c084fc;
        padding: 0.3rem 1rem;
        border-radius: 2rem;
        text-decoration: none;
        font-size: 0.85rem;
        text-align: center;
        transition: 0.2s;
        align-self: stretch;
        text-align: center;
    }
    .product-card .btn-details:hover {
        background: rgba(124,58,237,0.4);
        border-color: #c084fc;
    }
    .no-results {
        text-align: center;
        padding: 3rem;
        color: #b0a0c8;
    }
</style>

<div class="search-container">
    <h1 style="text-align:center; margin-bottom:1.5rem;">🔍 Search Products</h1>

    <form asp-action="Search" method="get" class="search-box">
        <input type="text" name="query" value="@query" placeholder="Search by name or description..." autofocus />
        <button type="submit">Search</button>
        @if (!string.IsNullOrEmpty(query))
        {
            <a href="/Home/Search" style="padding:0.7rem 1.2rem; border-radius:2rem; border:1px solid rgba(248,113,113,0.3); color:#f87171; text-decoration:none; display:inline-flex; align-items:center;">Clear</a>
        }
    </form>

    @if (!string.IsNullOrEmpty(query))
    {
        <div class="results-count">@Model.Count() result(s) for “@query”</div>
    }

    @if (!Model.Any())
    {
        <div class="glass-card no-results">
            @if (string.IsNullOrEmpty(query))
            {
                <p>Enter a keyword to start searching.</p>
            }
            else
            {
                <p>No products found matching <strong>“@query”</strong>. Try a different term.</p>
            }
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <div class="product-card glass-card">
                    <div class="product-image">
                        @(product.Category?.ToLower() switch
                        {
                            "laptop" => "💻",
                            "mobile" => "📱",
                            "desktop" => "🖥️",
                            _ => "📦"
                        })
                    </div>
                    <h3>@product.Name</h3>
                    <div class="price">@product.Price.ToString("C")</div>
                    <div class="stock">@product.StockQuantity in stock</div>
                    <a href="/Home/ProductDetails/@product.Id" class="btn-details">View Details →</a>
                </div>
            }
        </div>
    }
</div>
