@model ECommerceRex.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="glass-card" style="max-width:700px; margin:0 auto;">
    <div style="display:flex; flex-wrap:wrap; gap:2rem; align-items:flex-start;">
        <div style="flex:1; min-width:200px; text-align:center;">
            <div style="font-size:5rem;">
                @(Model.Category?.ToLower() switch
                {
                    "laptop" => "💻",
                    "mobile" => "📱",
                    "desktop" => "🖥️",
                    _ => "📦"
                })
            </div>
        </div>
        <div style="flex:2; min-width:250px;">
            <h2>@Model.Name</h2>
            <p style="color:#c084fc; font-size:1.8rem; font-weight:700;">@Model.Price.ToString("C")</p>
            <p><strong>Stock:</strong> @Model.StockQuantity</p>
            <p><strong>Category:</strong> @(Model.Category ?? "N/A")</p>
            <p><strong>Brand:</strong> @(Model.Supplier ?? "N/A")</p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p><strong>Description:</strong></p>
                <p style="color:#d8cff0;">@Model.Description</p>
            }
            <div style="margin-top:1rem; display:flex; gap:1rem; flex-wrap:wrap;">
                <a href="/Home/Product" class="btn-primary" style="width:auto; padding:0.5rem 1.5rem;">← Back to Products</a>
                <a href="#" class="btn-secondary" style="background:transparent; border:1px solid rgba(168,85,247,0.5); padding:0.5rem 1.5rem; border-radius:0.75rem; color:#c084fc; text-decoration:none;">Add to Cart</a>
            </div>
        </div>
    </div>
</div>
