<style>
    /* --- Carousel Styles --- */
    .carousel-container {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin: 2rem auto;
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .carousel-slides {
        display: flex;
        transition: transform 0.6s ease-in-out;
    }

    .carousel-slide {
        min-width: 100%;
        height: 400px;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding: 2rem 4rem;
        position: relative;
    }

    .carousel-slide::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(6, 2, 12, 0.5);
        backdrop-filter: blur(2px);
        z-index: 1;
    }

    .slide-content {
        position: relative;
        z-index: 2;
        max-width: 500px;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .slide-content h2 {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #c084fc, #d946ef);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: none;
    }

    .slide-content p {
        font-size: 1.2rem;
        margin-bottom: 1.2rem;
        color: #e0d7f0;
        -webkit-text-fill-color: #e0d7f0;
    }

    .slide-content .btn-primary {
        display: inline-block;
        width: auto;
        padding: 0.7rem 2rem;
        background: linear-gradient(135deg, #7c3aed, #6d28d9);
        border-radius: 2rem;
        font-weight: 600;
        text-decoration: none;
        color: #fff;
        transition: 0.2s;
        border: none;
    }

    .slide-content .btn-primary:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 20px rgba(124, 58, 237, 0.5);
    }

    /* Carousel controls */
    .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(24, 15, 41, 0.7);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(168, 85, 247, 0.3);
        color: #c084fc;
        font-size: 2rem;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 10;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

    .carousel-btn:hover {
        background: rgba(124, 58, 237, 0.4);
        border-color: #c084fc;
    }

    .carousel-btn.prev { left: 16px; }
    .carousel-btn.next { right: 16px; }

    /* Dots */
    .carousel-dots {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 10px;
        z-index: 10;
    }

    .carousel-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(168, 85, 247, 0.3);
        border: 2px solid rgba(168, 85, 247, 0.1);
        cursor: pointer;
        transition: 0.3s;
    }

    .carousel-dot.active {
        background: #c084fc;
        border-color: #c084fc;
        box-shadow: 0 0 12px rgba(124, 58, 237, 0.6);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .carousel-slide {
            height: 300px;
            padding: 1.5rem 2rem;
        }
        .slide-content h2 {
            font-size: 2rem;
        }
        .slide-content p {
            font-size: 1rem;
        }
        .carousel-btn {
            width: 36px;
            height: 36px;
            font-size: 1.4rem;
        }
        .carousel-dot {
            width: 10px;
            height: 10px;
        }
    }

    @@media (max-width: 480px) {
        .carousel-slide {
            height: 220px;
            padding: 1rem;
        }
        .slide-content h2 {
            font-size: 1.5rem;
        }
        .slide-content p {
            font-size: 0.85rem;
            margin-bottom: 0.6rem;
        }
        .slide-content .btn-primary {
            padding: 0.4rem 1rem;
            font-size: 0.8rem;
        }
        .carousel-btn {
            width: 28px;
            height: 28px;
            font-size: 1rem;
        }
        .carousel-btn.prev { left: 8px; }
        .carousel-btn.next { right: 8px; }
    }
</style>

