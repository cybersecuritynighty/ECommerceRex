@model ECommerceRex.Models.BankAccount
@{
    ViewData["Title"] = "Rex Got Bank";
    var balance = Model?.Balance ?? 0;
    var currency = Model?.Currency ?? "USD";
}

<!-- Bank Page Header with Navigation -->
<div class="bank-header glass-card" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding:1rem 1.5rem; margin-bottom:2rem; background:rgba(24,15,41,0.4);">
    <div>
        <h1 style="margin:0; font-size:2rem; background:linear-gradient(135deg, #c084fc, #d946ef); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
            Rex Got Bank
        </h1>
        <span style="color:#b0a0c8; font-size:0.9rem;">Your secure financial hub</span>
    </div>
    <nav style="display:flex; gap:1.5rem; flex-wrap:wrap;">
        <a href="/" style="color:#d8cff0; text-decoration:none; font-weight:500; transition:color 0.2s;" onmouseover="this.style.color='#c084fc'" onmouseout="this.style.color='#d8cff0'">Home</a>
        <a href="/Home/About" style="color:#d8cff0; text-decoration:none; font-weight:500; transition:color 0.2s;" onmouseover="this.style.color='#c084fc'" onmouseout="this.style.color='#d8cff0'">About</a>
        <a href="/Home/Service" style="color:#d8cff0; text-decoration:none; font-weight:500; transition:color 0.2s;" onmouseover="this.style.color='#c084fc'" onmouseout="this.style.color='#d8cff0'">Service</a>
    </nav>
</div>

<!-- Account Summary -->
<div class="glass-card" style="margin-bottom:1.5rem;">
    <h2>My Bank Account</h2>
    <div style="display:flex; flex-wrap:wrap; gap:2rem; margin-top:0.5rem;">
        <div>
            <div style="color:#b0a0c8; font-size:0.9rem;">Balance</div>
            <div style="font-size:2.2rem; font-weight:700; color:#c084fc;">@balance.ToString("C")</div>
        </div>
        <div>
            <div style="color:#b0a0c8; font-size:0.9rem;">Currency</div>
            <div style="font-size:1.4rem; font-weight:600; color:#e0d7f0;">@currency</div>
        </div>
        <div>
            <div style="color:#b0a0c8; font-size:0.9rem;">Account Status</div>
            <div style="font-size:1.2rem; font-weight:600; color:#4ade80;">Active</div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem;">
    <a href="/Bank/Wallet" class="btn-primary" style="width:auto; padding:0.6rem 1.8rem;">💰 Wallet</a>
    <a href="/Bank/History" class="btn-primary" style="width:auto; padding:0.6rem 1.8rem; background:linear-gradient(135deg, #6d28d9, #4c1d95);">📊 History</a>
    <a href="/Bank/Account" class="btn-primary" style="width:auto; padding:0.6rem 1.8rem; background:linear-gradient(135deg, #059669, #047857);">⚙️ Settings</a>
</div>

<!-- Additional Info (optional) -->
<div class="glass-card" style="padding:1rem; background:rgba(24,15,41,0.3);">
    <p style="margin:0; color:#b0a0c8; font-size:0.9rem;">
        <span style="color:#c084fc;">🔒</span> Your transactions are protected with JWT and HMAC‑SHA256 ledger.
    </p>
</div>
