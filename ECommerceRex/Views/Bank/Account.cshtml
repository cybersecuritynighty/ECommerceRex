@model ECommerceRex.Models.ViewModels.BankAccountViewModel
@{
    ViewData["Title"] = "Account Settings";
    var successMsg = TempData["Success"] as string;
}

<div class="glass-card" style="max-width:700px; margin:0 auto;">
    <h2>Account Settings</h2>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div style="background:rgba(74,222,128,0.15); padding:0.5rem 1rem; border-radius:0.5rem; color:#4ade80; margin-bottom:1rem;">
            @successMsg
        </div>
    }

    <form asp-action="UpdateAccount" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <h3>Personal Information</h3>
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="+1 555 123 4567" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Address"></label>
            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street, City, Country"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <hr style="border-color: rgba(168,85,247,0.2); margin:1.5rem 0;" />

        <h3>Credit Card Information</h3>
        <div class="form-group">
            <label asp-for="CardHolderName"></label>
            <input asp-for="CardHolderName" class="form-control" placeholder="Name on card" />
            <span asp-validation-for="CardHolderName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="CardNumber"></label>
            <input asp-for="CardNumber" class="form-control" placeholder="**** **** **** ****" />
            <span asp-validation-for="CardNumber" class="text-danger"></span>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div class="form-group">
                <label asp-for="CardExpiry">Expiry (MM/YY)</label>
                <input asp-for="CardExpiry" class="form-control" placeholder="MM/YY" />
                <span asp-validation-for="CardExpiry" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>CVV</label>
                <input class="form-control" placeholder="***" type="password" maxlength="4" />
                <small style="color:#b0a0c8;">Not stored</small>
            </div>
        </div>

        <hr style="border-color: rgba(168,85,247,0.2); margin:1.5rem 0;" />

        <h3>Wallet Info</h3>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
            <div class="form-group" style="flex:1; min-width:150px;">
                <label>Balance</label>
                <input class="form-control" value="@Model.Balance.ToString("C")" disabled />
            </div>
            <div class="form-group" style="flex:1; min-width:150px;">
                <label>Currency</label>
                <input asp-for="Currency" class="form-control" disabled />
            </div>
        </div>

        <button type="submit" class="btn-primary">Save Changes</button>
        <a href="/Bank" class="btn-secondary" style="display:inline-block; margin-left:1rem;">Back</a>
    </form>
</div>
