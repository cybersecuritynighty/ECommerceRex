@{
    ViewData["Title"] = "Forbidden";
}
<div class="error-page glass-card" style="max-width:600px; margin:4rem auto; text-align:center; padding:3rem 2rem;">
    <div style="font-size:4rem; margin-bottom:1rem;">🚫</div>
    <h1 style="color:#f87171;">403 – Forbidden</h1>
    <p style="color:#d8cff0; margin:1.5rem 0;">You do not have permission to access this resource.</p>
    <p style="color:#b0a0c8;">If you believe this is an error, contact your administrator.</p>
    <div style="display:flex; gap:1rem; justify-content:center; margin-top:2rem; flex-wrap:wrap;">
        <a href="/" class="btn-primary" style="width:auto; padding:0.5rem 1.5rem;">Go Home</a>
        <a href="javascript:history.back()" class="btn-secondary" style="background:transparent; border:1px solid rgba(168,85,247,0.5); padding:0.5rem 1.5rem; border-radius:0.75rem; color:#c084fc; text-decoration:none;">Go Back</a>
    </div>
</div>
